# ── Development (SQLite) ───────────────────────────────────────────────────────
# These defaults work out of the box — no changes needed for local dev

DJANGO_SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DJANGO_DEBUG=True

# ── Production / Hostinger MySQL ───────────────────────────────────────────────
# Uncomment and fill in these values when deploying to Hostinger VPS
#
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=autoparts_db
# DB_USER=autoparts_user
# DB_PASSWORD=your_strong_password_here
# DB_HOST=localhost
# DB_PORT=3306
#
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=your-production-secret-key-here
#
# ── Notes ──────────────────────────────────────────────────────────────────────
# 1. On Hostinger: pip install mysqlclient  (uncomment in requirements.txt)
# 2. Run:  python manage.py migrate
# 3. Run:  python manage.py seed_vehicles
# 4. Run:  python manage.py seed_parts
# 5. Run:  python manage.py seed_360_demo
# 6. Run:  python manage.py createsuperuser
